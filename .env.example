# HR Mailer Pro Environment Configuration

# Server Environment
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:5000

# Authentication Modes
# Set ENABLE_MOCK_AUTH=true for local development testing without active Google Cloud credentials
ENABLE_MOCK_AUTH=true

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Security & Encryption Keys
JWT_SECRET=generate-a-secure-random-64-character-hex-string-for-jwt
SESSION_SECRET=generate-another-secure-random-string-for-express-sessions
ENCRYPTION_KEY=32-character-secret-key-for-aes256-gcm!

# Database Configuration
DB_PATH=./database/hrmailer.sqlite
